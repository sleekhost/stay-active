#!/bin/bash
#
# stay-active - Keep Microsoft Teams (and other apps) showing you as "Active"
# Author: Sleekhost
# License: MIT
# Repository: https://github.com/sleekhost/stay-active
#
VERSION="1.0.0"

CONTROL_FILE="$HOME/.local/.stay_active_on"
PID_FILE="$HOME/.local/.stay_active_pid"
LOG_FILE="$HOME/.local/.stay_active_log"

# Detect OS and CPU architecture
OS="$(uname -s)"    # Darwin = macOS, Linux = Linux
ARCH="$(uname -m)"  # arm64 = Apple Silicon (M1/M2/M3/M4), x86_64 = Intel

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

show_help() {
    if [ "$OS" = "Darwin" ]; then
        OS_LINE="macOS 10.13+ (Intel and Apple Silicon)"
        DEPS_LINE="cliclick (install via: brew install cliclick)"
        EXTRA_LINE="    - Accessibility permissions for Terminal"
    else
        OS_LINE="Linux (Ubuntu, Fedora, Arch, and others)"
        DEPS_LINE="xdotool (install via your package manager)"
        EXTRA_LINE=""
    fi

    cat << EOF
stay-active v${VERSION}
Keep Microsoft Teams (and other apps) showing you as "Active"

USAGE:
    stay-active <command>

COMMANDS:
    start       Start the activity daemon
    stop        Stop the activity daemon
    toggle      Toggle the daemon on/off
    status      Check if daemon is running
    log         View recent activity log

OPTIONS:
    -h, --help      Show this help message
    -v, --version   Show version number

EXAMPLES:
    stay-active start     # Start keeping you active
    stay-active stop      # Stop the daemon
    stay-active toggle    # Quick toggle on/off
    stay-active log       # See what it's been doing

HOW IT WORKS:
    Simulates natural mouse movement and keyboard activity at random
    intervals (30-60 seconds) to prevent apps from marking you as "Away".
    Uses human-like patterns to avoid detection.

REQUIREMENTS:
    - ${OS_LINE}
    - ${DEPS_LINE}
${EXTRA_LINE}

AUTHOR:
    Sleekhost
    https://github.com/sleekhost/stay-active

EOF
}

show_version() {
    echo "stay-active v${VERSION}"
}

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

get_random_interval() {
    echo $((30 + RANDOM % 31))
}

get_random_offset() {
    echo $((RANDOM % 11 - 5))
}

# --- OS abstraction helpers ---

check_deps() {
    case "$OS" in
        Darwin)
            if ! command -v cliclick &> /dev/null; then
                # Show the correct Homebrew path for this Mac's chip
                if [ "$ARCH" = "arm64" ]; then
                    CLICLICK_PATH="/opt/homebrew/bin/cliclick"
                else
                    CLICLICK_PATH="/usr/local/bin/cliclick"
                fi
                echo -e "${RED}Error: cliclick not found${NC}"
                echo ""
                echo "Install it with:"
                echo "  brew install cliclick"
                echo ""
                echo "Then grant Accessibility permissions in:"
                echo "  System Settings → Privacy & Security → Accessibility"
                echo "  Add: Terminal (or your terminal app)"
                echo "  Add: ${CLICLICK_PATH}"
                exit 1
            fi
            ;;
        Linux)
            if ! command -v xdotool &> /dev/null; then
                echo -e "${RED}Error: xdotool not found${NC}"
                echo ""
                echo "Install it with:"
                echo "  Ubuntu/Debian:  sudo apt install xdotool"
                echo "  Fedora/RHEL:    sudo dnf install xdotool"
                echo "  Arch Linux:     sudo pacman -S xdotool"
                echo "  openSUSE:       sudo zypper install xdotool"
                exit 1
            fi
            ;;
        *)
            echo -e "${RED}Error: Unsupported OS: ${OS}${NC}"
            echo "stay-active supports macOS and Linux."
            exit 1
            ;;
    esac
}

# Returns current mouse position as "x,y"
get_mouse_pos() {
    case "$OS" in
        Darwin)
            cliclick p 2>/dev/null | grep -oE '[0-9]+,[0-9]+'
            ;;
        Linux)
            local info
            info=$(xdotool getmouselocation 2>/dev/null)
            local x y
            x=$(echo "$info" | grep -oP '(?<=x:)\d+')
            y=$(echo "$info" | grep -oP '(?<=y:)\d+')
            [ -n "$x" ] && [ -n "$y" ] && echo "${x},${y}"
            ;;
    esac
}

# Move mouse to x,y
move_mouse() {
    local x=$1 y=$2
    case "$OS" in
        Darwin) cliclick -e 30 m:${x},${y} 2>/dev/null ;;
        Linux)  xdotool mousemove --sync "$x" "$y" 2>/dev/null ;;
    esac
}

# Press and release Shift key (registers as activity without disrupting user)
press_shift() {
    case "$OS" in
        Darwin) cliclick kd:shift ku:shift 2>/dev/null ;;
        Linux)  xdotool key shift 2>/dev/null ;;
    esac
}

# --- Core daemon ---

simulate_activity() {
    log_msg "Daemon started (v${VERSION})"

    while [ -f "$CONTROL_FILE" ]; do
        current_pos=$(get_mouse_pos)

        if [ -n "$current_pos" ]; then
            current_x=$(echo "$current_pos" | cut -d',' -f1)
            current_y=$(echo "$current_pos" | cut -d',' -f2)

            offset_x=$(get_random_offset)
            offset_y=$(get_random_offset)

            new_x=$((current_x + offset_x))
            new_y=$((current_y + offset_y))

            [ $new_x -lt 10 ] && new_x=10
            [ $new_y -lt 10 ] && new_y=10

            move_mouse "$new_x" "$new_y"

            sleep 0.$((RANDOM % 3 + 1))

            press_shift

            log_msg "Activity: mouse ($current_x,$current_y)->($new_x,$new_y) + shift key"

            # 60% chance to move back (natural behavior)
            if [ $((RANDOM % 10)) -lt 6 ]; then
                sleep 0.$((RANDOM % 5 + 1))
                move_mouse "$current_x" "$current_y"
            fi
        else
            log_msg "Warning: Could not get mouse position"
        fi

        interval=$(get_random_interval)

        # 15% chance of shorter burst (more active period)
        if [ $((RANDOM % 100)) -lt 15 ]; then
            interval=$((15 + RANDOM % 15))
        fi

        log_msg "Sleeping ${interval}s"

        for ((i=0; i<interval; i++)); do
            [ ! -f "$CONTROL_FILE" ] && break
            sleep 1
        done
    done

    log_msg "Daemon stopped"
}

start_daemon() {
    check_deps

    if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
        echo -e "${YELLOW}Already running${NC}"
        return 1
    fi

    # Ensure directory exists
    mkdir -p "$HOME/.local"

    # Keep last 100 log lines
    if [ -f "$LOG_FILE" ]; then
        tail -100 "$LOG_FILE" > "$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
    fi

    touch "$CONTROL_FILE"
    simulate_activity &
    echo $! > "$PID_FILE"
    echo -e "${GREEN}Started${NC} (PID: $(cat $PID_FILE))"
}

stop_daemon() {
    rm -f "$CONTROL_FILE"

    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null
            log_msg "Stopped by user"
            echo -e "${RED}Stopped${NC}"
        else
            echo -e "${YELLOW}Not running${NC}"
        fi
        rm -f "$PID_FILE"
    else
        echo -e "${YELLOW}Not running${NC}"
    fi
}

toggle_daemon() {
    if [ -f "$CONTROL_FILE" ]; then
        stop_daemon
    else
        start_daemon
    fi
}

status_daemon() {
    if [ -f "$CONTROL_FILE" ] && [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
        echo -e "${GREEN}Running${NC} (PID: $(cat $PID_FILE))"
        return 0
    else
        echo -e "${RED}Stopped${NC}"
        return 1
    fi
}

show_log() {
    if [ -f "$LOG_FILE" ]; then
        echo -e "${YELLOW}Recent activity:${NC}"
        echo ""
        tail -20 "$LOG_FILE"
    else
        echo "No activity log yet. Start the daemon first."
    fi
}

# Parse arguments
case "${1:-}" in
    start)
        start_daemon
        ;;
    stop)
        stop_daemon
        ;;
    toggle)
        toggle_daemon
        ;;
    status)
        status_daemon
        ;;
    log)
        show_log
        ;;
    -h|--help|help)
        show_help
        ;;
    -v|--version|version)
        show_version
        ;;
    "")
        echo "stay-active v${VERSION}"
        echo ""
        echo "Usage: stay-active <command>"
        echo ""
        echo "Commands: start, stop, toggle, status, log"
        echo ""
        echo "Run 'stay-active --help' for more information."
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'stay-active --help' for usage information."
        exit 1
        ;;
esac
